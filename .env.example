# Copy to .env (or set in your host's dashboard) and restart.

# Password for /studio — change this before going live.
ARTIST_PASSWORD=youngsilence

# Long random string used to sign studio and fan sessions. If unset, one is
# generated and stored in data/.secret.
SESSION_SECRET=

# Optional: enables real card payments. Get these from dashboard.paystack.com.
# Without them the site runs card checkout in sandbox mode (nothing is charged).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Port (defaults to 3000)
PORT=3000

# Neon Postgres — comments are stored in Postgres when this is set, otherwise
# they fall back to data/db.json (useful for local dev and tests).
# Vercel/Neon provide POSTGRES_URL_NO_SSL; we also accept DATABASE_URL.
POSTGRES_URL_NO_SSL=
DATABASE_URL=
# Or: POSTGRES_URL=  (pooled variant)

# Where uploads and the JSON database live (defaults to ./data).
# In production this MUST be a persistent volume (e.g. Render disk /var/data),
# otherwise saved themes, settings and uploads are wiped on every restart.
DATA_DIR=
